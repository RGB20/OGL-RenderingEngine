#version 410 core

layout (triangles, fractional_odd_spacing, ccw) in;

uniform mat4 model;
uniform mat3 modelInvT;
uniform mat4 view;
uniform mat4 projection;

in vec2 TextureCoords[];

// send to geometry shader
out float Height;
out vec2 uv;
out vec3 normal;

uniform sampler2D heightMap;
uniform float heightScale;

vec2 interpolate2D(vec2 v0, vec2 v1, vec2 v2)
{
    return gl_TessCoord.x * v0 + gl_TessCoord.y * v1 + gl_TessCoord.z * v2;
}

vec3 interpolate3D(vec3 v0, vec3 v1, vec3 v2)
{
    return gl_TessCoord.x * v0 + gl_TessCoord.y * v1 + gl_TessCoord.z * v2;
}

vec3 CalculateNormal(vec2 uv, float height, vec2 textureScale) 
{
    float hX = texture(heightMap, uv + vec2(textureScale.x, 0.0)).r;
    float hZ = texture(heightMap, uv + vec2(0.0, textureScale.y)).r;

    vec3 dpdx = vec3(1.0, ((hX - height)) / textureScale.x, 0.0);
    vec3 dpdz = vec3(0.0, ((hZ - height)) / textureScale.y, 1.0);

    //if (abs(dpdx.y) == 0.0 || abs(dpdz.y) == 0.0)
    //{
    //    return vec3(0.0f, 1.0f, 0.0f);
    //}

    normal = normalize(cross(dpdz, dpdx));

    //vec3 centerPoint = vec3(0.0f, height, 0.0f);

    //vec3 leftPoint = vec3(-textureScale.x, texture(heightMap, uv + vec2(-textureScale.x, 0.0f)).r, 0.0f);
    //vec3 downPoint = vec3(0.0f, texture(heightMap, uv + vec2(0.0f, -textureScale.y)).r, -textureScale.y);

    //vec3 normal = normalize(cross(downPoint, leftPoint));// * 10.0f;

    return normal;
}


void main()
{  
    // Calculate Interpolated UV
    vec2 textureCoord_Interpolated = interpolate2D(TextureCoords[0], TextureCoords[1], TextureCoords[2]);
    uv = textureCoord_Interpolated;
    
    // Calculate Interpolarted Pos (object space)
    vec3 objectSpace_Interpolated = interpolate3D((gl_in[0].gl_Position).rgb, (gl_in[1].gl_Position).rgb, (gl_in[2].gl_Position).rgb);
    
    // displace point along normal (Y - Axis in object space)
    Height = texture(heightMap, textureCoord_Interpolated).r;
    float height_scaled = Height * heightScale;
    objectSpace_Interpolated.y += height_scaled;

    // get texture dimensions
    vec2 textureSize = textureSize(heightMap, 0);
    vec2 textureScale = vec2(1.0f/textureSize.x, 1.0f/textureSize.y);

    vec3 objectSpaceNormal = CalculateNormal(uv, Height, textureScale);
    vec3 worldSpaceNormal = normalize(modelInvT * objectSpaceNormal);
    normal = worldSpaceNormal;

    // ----------------------------------------------------------------------
    // output patch point position in world space -> Geometry shader will output in NDC / clip space
    gl_Position = model * vec4(objectSpace_Interpolated, 1.0f);
};