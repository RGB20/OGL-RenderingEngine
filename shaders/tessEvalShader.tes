#version 430 core

layout (triangles, fractional_odd_spacing, ccw) in;

uniform mat4 model;
uniform mat3 modelInvT;
uniform mat4 view;
uniform mat4 projection;
uniform int terrainDimX;
uniform int terrainDimY;

in vec2 TextureCoords[];

out float fHeight;
out vec2 fuv;
out vec3 fNormal;
out vec3 fFragpos;

uniform sampler2D heightMap;

layout(std430, binding = 1) readonly buffer normalBuffer {
    vec4 normals[];
};

vec2 interpolate2D(vec2 v0, vec2 v1, vec2 v2)
{
    return gl_TessCoord.x * v0 + gl_TessCoord.y * v1 + gl_TessCoord.z * v2;
}

vec3 interpolate3D(vec3 v0, vec3 v1, vec3 v2)
{
    return gl_TessCoord.x * v0 + gl_TessCoord.y * v1 + gl_TessCoord.z * v2;
}

vec3 LoadNormal(uint x, uint y)
{
    x = min(x, uint(terrainDimX - 1));
    y = min(y, uint(terrainDimY - 1));
    return normals[x + y * uint(terrainDimX)].xyz;
}

vec3 SampleNormal(vec2 texCoord)
{
    vec2 normalCoord = clamp(texCoord, vec2(0.0), vec2(1.0)) * vec2(terrainDimX - 1, terrainDimY - 1);
    uvec2 baseCoord = uvec2(floor(normalCoord));
    uvec2 nextCoord = min(baseCoord + uvec2(1), uvec2(terrainDimX - 1, terrainDimY - 1));
    vec2 blend = fract(normalCoord);

    vec3 n00 = LoadNormal(baseCoord.x, baseCoord.y);
    vec3 n10 = LoadNormal(nextCoord.x, baseCoord.y);
    vec3 n01 = LoadNormal(baseCoord.x, nextCoord.y);
    vec3 n11 = LoadNormal(nextCoord.x, nextCoord.y);

    vec3 nx0 = mix(n00, n10, blend.x);
    vec3 nx1 = mix(n01, n11, blend.x);
    return normalize(mix(nx0, nx1, blend.y));
}

void main()
{  
    // Calculate Interpolated UV
    vec2 textureCoord_Interpolated = interpolate2D(TextureCoords[0], TextureCoords[1], TextureCoords[2]);
    fuv = textureCoord_Interpolated;
    
    fHeight = texture(heightMap, fuv).r;

    // Calculate Interpolarted Pos (object space)
    vec3 objectSpace_Interpolated = interpolate3D((gl_in[0].gl_Position).rgb, (gl_in[1].gl_Position).rgb, (gl_in[2].gl_Position).rgb);
    vec3 objectSpacePos = objectSpace_Interpolated + vec3(0.0, fHeight, 0.0);
    vec3 objectSpaceNormal = SampleNormal(fuv);

    vec3 worldSpaceNormal = normalize(modelInvT * objectSpaceNormal);
    vec4 worldSpacePos = model * vec4(objectSpacePos, 1.0f);

    fNormal = worldSpaceNormal;
    fFragpos = worldSpacePos.xyz;
    gl_Position = projection * view * worldSpacePos;
}
